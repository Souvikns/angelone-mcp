# From https://smartapi.angelone.in/ → My Apps → API Key
ANGEL_API_KEY=
# Your Angel One client ID (e.g. A123456)
ANGEL_CLIENT_CODE=
# Your 4-digit login MPIN
ANGEL_PIN=
# Base32 secret shown when enabling TOTP at https://smartapi.angelone.in/enable-totp
ANGEL_TOTP_SECRET=
# Set to true to expose order placement / modification / cancellation tools
ANGEL_ENABLE_TRADING=false

# Optional: sent as X-ClientLocalIP / X-ClientPublicIP / X-MACAddress headers.
# If your API key has a whitelisted static IP, set ANGEL_PUBLIC_IP to it.
# ANGEL_LOCAL_IP=
# ANGEL_PUBLIC_IP=
# ANGEL_MAC_ADDRESS=
